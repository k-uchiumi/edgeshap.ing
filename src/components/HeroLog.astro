---
interface Props { lang: 'en' | 'ja'; }
const { lang } = Astro.props;
const t = lang === 'ja'
  ? {
      eyebrow: 'AI BOT OBSERVABILITY',
      h1a: 'AIボットは、もう',
      h1b: 'あなたのサイトに来ている。',
      lead: 'EdgeShapingは、GPTBotをはじめとするAIクローラーの訪問を記録し、人間のアクセスと並べて可視化する観測フレームワーク。どのページがAIに読まれ、どのページが読まれていないかを、そのまま確認できます。',
      cta1: '仕組みを見る',
      cta2: 'エディション比較',
      how: '/ja/how-it-works',
      editions: '/ja/editions'
    }
  : {
      eyebrow: 'AI BOT OBSERVABILITY',
      h1a: 'AI bots are already',
      h1b: 'reading your site.',
      lead: 'EdgeShaping records visits from GPTBot and other AI crawlers, then puts them side by side with human traffic — so you can see which pages AI is reading, and which it never reaches.',
      cta1: 'How it works',
      cta2: 'Compare editions',
      how: '/how-it-works',
      editions: '/editions'
    };
---
<section class="hero shallow">
  <div class="log-stream" aria-hidden="true" id="logStream"></div>
  <div class="wrap hero-inner">
    <span class="eyebrow" style="color: var(--ai);">{t.eyebrow}</span>
    <h1><span class="decode" data-text={t.h1a}>{t.h1a}</span><br /><span class="decode" data-text={t.h1b}>{t.h1b}</span></h1>
    <p class="lead">{t.lead}</p>
    <div class="ctas">
      <a class="btn btn-ai" href={t.how}>{t.cta1}</a>
      <a class="btn btn-ghost" href={t.editions}>{t.cta2}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 140px 0 100px;
  }
  .hero-inner { position: relative; z-index: 2; }
  .hero-inner::before {
    content: ""; position: absolute; inset: -40px -60px;
    background: radial-gradient(ellipse at 30% 50%, rgba(245,248,247,0.94) 40%, rgba(245,248,247,0.55) 70%, transparent 100%);
    z-index: -1;
  }
  h1 {
    font-size: clamp(34px, 6vw, 68px);
    margin: 18px 0 22px;
    color: var(--ink);
  }
  .decode { white-space: pre-wrap; }
  .lead { margin-bottom: 36px; }
  .ctas { display: flex; gap: 16px; flex-wrap: wrap; }
  .log-stream {
    position: absolute;
    inset: 0;
    z-index: 1;
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 2.3;
    color: rgba(70, 86, 107, 0.42);
    padding: 24px 28px;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent);
            mask-image: linear-gradient(to right, transparent 0%, #000 4%, #000 96%, transparent);
  }
  .log-stream :global(.ln) { display: flex; gap: 14px; white-space: nowrap; opacity: 0; }
  .log-stream :global(.bot) { color: rgba(14, 147, 132, 0.85); }
  .log-stream :global(.cls) { color: rgba(70, 86, 107, 0.65); }
  @media (max-width: 720px) { .log-stream { font-size: 11px; } }
</style>

<script>
  import { gsap } from 'gsap';

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Vendor-documented bots only; categories use EdgeShaping's official keys.
  const BOTS = [
    ['GPTBot', 'learning'],
    ['OAI-SearchBot', 'search_rag'],
    ['ChatGPT-User', 'user_trigger'],
    ['ClaudeBot', 'learning'],
    ['Claude-SearchBot', 'search_rag'],
    ['Claude-User', 'user_trigger'],
    ['PerplexityBot', 'search_rag'],
    ['Perplexity-User', 'user_trigger'],
    ['Google-Extended', 'learning'],
    ['Googlebot', 'crawl'],
    ['bingbot', 'crawl'],
    ['Applebot', 'crawl'],
    ['Applebot-Extended', 'learning'],
    ['CCBot', 'learning']
  ];
  const PATHS = [
    '/blog/ai-visibility', '/docs/getting-started', '/pricing', '/blog/ahqg-matrix',
    '/features', '/blog/inferred-path', '/changelog', '/about', '/blog/dark-pages',
    '/integrations', '/faq', '/blog/bot-dictionary'
  ];
  const pad = (n: number) => String(n).padStart(2, '0');

  function makeLine(): HTMLElement {
    const [bot, cls] = BOTS[Math.floor(Math.random() * BOTS.length)];
    const path = PATHS[Math.floor(Math.random() * PATHS.length)];
    const d = new Date(Date.now() - Math.random() * 60000);
    const ts = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    const el = document.createElement('div');
    el.className = 'ln';
    el.innerHTML = `<span>${ts}</span><span class="bot">${bot}</span><span>GET ${path}</span><span>200</span><span class="cls">[${cls}]</span>`;
    return el;
  }

  const stream = document.getElementById('logStream');
  if (stream) {
    const MAX = 26;
    // initial fill
    for (let i = 0; i < 14; i++) {
      const ln = makeLine();
      ln.style.opacity = '0.9';
      stream.appendChild(ln);
    }
    if (!reduced) {
      const tick = () => {
        const ln = makeLine();
        stream.appendChild(ln);
        gsap.fromTo(ln, { opacity: 0, x: -8 }, { opacity: 0.95, x: 0, duration: 0.5 });
        while (stream.children.length > MAX) {
          stream.removeChild(stream.firstChild!);
        }
        setTimeout(tick, 500 + Math.random() * 900);
      };
      setTimeout(tick, 600);
    }
  }

  // headline decode effect
  const GLYPHS = 'Mozilla/5.0GPTBot()+;:._%$#@!<>ABCDEFabcdef0123456789';
  document.querySelectorAll<HTMLElement>('.decode').forEach((el, i) => {
    const target = el.dataset.text ?? el.textContent ?? '';
    if (reduced) { el.textContent = target; return; }
    const chars = [...target];
    const obj = { p: 0 };
    el.textContent = chars.map((c) => (c === ' ' ? ' ' : GLYPHS[Math.floor(Math.random() * GLYPHS.length)])).join('');
    gsap.to(obj, {
      p: 1,
      duration: 1.4,
      delay: 0.25 + i * 0.45,
      ease: 'power2.inOut',
      onUpdate() {
        const cut = Math.floor(obj.p * chars.length);
        el.textContent = chars
          .map((c, j) => (j < cut || c === ' ' ? c : GLYPHS[Math.floor(Math.random() * GLYPHS.length)]))
          .join('');
      },
      onComplete() { el.textContent = target; }
    });
  });
</script>
