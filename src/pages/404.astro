---
import Base from '../layouts/Base.astro';
---
<Base
  title="Page not found — EdgeShaping"
  description="The page you were looking for doesn't exist. ページが見つかりませんでした。"
  lang="ja"
  path="/404"
  noindex
>
  <section class="deep" style="padding-top: 160px; min-height: 70vh;">
    <div class="wrap">
      <span class="eyebrow" style="color: var(--ai);">404</span>
      <h1 class="page-title" style="color: var(--foam);">ページが見つかりませんでした。</h1>
      <p class="lead">URLが変わったか、削除された可能性があります。 / This page doesn't exist or has moved.</p>
      <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px;">
        <a class="btn btn-ai" href="/ja">トップへ</a>
        <a class="btn btn-ghost" href="/ja/editions">エディション比較</a>
        <a class="btn btn-ghost" href="/ja/blog">ブログ</a>
        <a class="btn btn-ghost" href="/">English home</a>
      </div>
    </div>
  </section>
</Base>
